{
  "$comment": "API 1.1 delta. Merged over the frozen 1.0 definitions BY NAME by contracts.build_1_1: x-overrides replace 1.0 definitions, x-additions are new; nothing else changes. Never edit the 1.0 file.",
  "x-overrides": [
    "AnswerEnvelope",
    "ErrorCode",
    "Limitation",
    "Locator",
    "SafeEvent"
  ],
  "x-additions": [
    "Coverage",
    "ConsentRequest",
    "ConsentState",
    "IndexStatus",
    "ModelDescriptor",
    "PassageText",
    "ComputeRequest",
    "ComputeResult"
  ],
  "$defs": {
    "AnswerEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "answer",
        "citations",
        "verification",
        "language",
        "limitations",
        "not_searched",
        "coverage"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/Opaque"
        },
        "answer": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        },
        "language": {
          "$ref": "#/$defs/LanguageInfo"
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Limitation"
          }
        },
        "not_searched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotSearched"
          }
        },
        "withheld_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotSearched"
          },
          "description": "Sources whose retrieval is CONFIRMED (content retrieved from them is durably recorded in the task's saved passages) but whose permission was revoked since; the answer built from them is withheld or was never produced. Not the same as not_searched or search_attempted_sources."
        },
        "search_attempted_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotSearched"
          },
          "description": "Sources whose search was started but for which NO retrieved content is durably recorded: the search may have found nothing, or the process may have stopped before the passages were saved. Nothing from them is represented in any answer; whether anything was found is not established. Not the same as withheld_sources or not_searched."
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "model": {
          "$ref": "#/$defs/ModelDescriptor"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "properties": {
                  "state": {
                    "const": "indexing"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "indexing_incomplete"
                }
              }
            },
            "required": [
              "limitations"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "indexing_incomplete"
                }
              }
            },
            "required": [
              "limitations"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "state": {
                    "const": "indexing"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "properties": {
                  "pending": {
                    "contains": {
                      "properties": {
                        "category": {
                          "const": "attachments"
                        }
                      },
                      "required": [
                        "category"
                      ]
                    }
                  }
                },
                "required": [
                  "pending"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "attachment_pending"
                }
              }
            },
            "required": [
              "limitations"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "attachment_pending"
                }
              }
            },
            "required": [
              "limitations"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "pending": {
                    "contains": {
                      "properties": {
                        "category": {
                          "const": "attachments"
                        }
                      },
                      "required": [
                        "category"
                      ]
                    }
                  }
                },
                "required": [
                  "pending"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "properties": {
                  "pending": {
                    "contains": {
                      "properties": {
                        "category": {
                          "const": "unsupported_source"
                        }
                      },
                      "required": [
                        "category"
                      ]
                    }
                  }
                },
                "required": [
                  "pending"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "source_unsupported"
                }
              }
            },
            "required": [
              "limitations"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "source_unsupported"
                }
              }
            },
            "required": [
              "limitations"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "pending": {
                    "contains": {
                      "properties": {
                        "category": {
                          "const": "unsupported_source"
                        }
                      },
                      "required": [
                        "category"
                      ]
                    }
                  }
                },
                "required": [
                  "pending"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "properties": {
                  "pending": {
                    "contains": {
                      "properties": {
                        "category": {
                          "const": "os_access"
                        }
                      },
                      "required": [
                        "category"
                      ]
                    }
                  }
                },
                "required": [
                  "pending"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "os_access_missing"
                }
              }
            },
            "required": [
              "limitations"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "os_access_missing"
                }
              }
            },
            "required": [
              "limitations"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "pending": {
                    "contains": {
                      "properties": {
                        "category": {
                          "const": "os_access"
                        }
                      },
                      "required": [
                        "category"
                      ]
                    }
                  }
                },
                "required": [
                  "pending"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "properties": {
                  "failed": {
                    "minItems": 1
                  }
                },
                "required": [
                  "failed"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "partial_work"
                }
              }
            },
            "required": [
              "limitations"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "coverage": {
                    "properties": {
                      "state": {
                        "const": "partial"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  }
                },
                "required": [
                  "coverage"
                ]
              },
              {
                "properties": {
                  "coverage": {
                    "properties": {
                      "pending": {
                        "contains": {
                          "properties": {
                            "category": {
                              "const": "not_yet_indexed"
                            }
                          },
                          "required": [
                            "category"
                          ]
                        }
                      }
                    },
                    "required": [
                      "pending"
                    ]
                  }
                },
                "required": [
                  "coverage"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "limitations": {
                "contains": {
                  "const": "partial_work"
                }
              }
            },
            "required": [
              "limitations"
            ]
          }
        }
      ]
    },
    "ConsentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/SourceType"
          }
        }
      },
      "description": "The single Get Started consent: which source types the owner enables. Shape only in WP3.1."
    },
    "ConsentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants",
        "sources"
      ],
      "properties": {
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceGrant"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_type",
              "os_access"
            ],
            "properties": {
              "source_type": {
                "$ref": "#/$defs/SourceType"
              },
              "os_access": {
                "type": "string",
                "enum": [
                  "granted",
                  "missing",
                  "unknown"
                ]
              }
            }
          }
        }
      },
      "description": "Shape only in WP3.1."
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "searched",
        "total",
        "pending",
        "failed",
        "as_of"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "indexing"
          ]
        },
        "searched": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "count"
            ],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "not_yet_indexed",
                  "attachments",
                  "unsupported_source",
                  "os_access"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason_code",
              "count"
            ],
            "properties": {
              "reason_code": {
                "type": "string",
                "enum": [
                  "unsupported_format",
                  "encrypted",
                  "corrupt",
                  "too_large",
                  "limit_exceeded",
                  "extraction_failed",
                  "timeout"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "as_of": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "pending": {
                "maxItems": 0
              },
              "failed": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "partial"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "pending": {
                    "minItems": 1
                  }
                },
                "required": [
                  "pending"
                ]
              },
              {
                "properties": {
                  "failed": {
                    "minItems": 1
                  }
                },
                "required": [
                  "failed"
                ]
              }
            ]
          }
        }
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unsupported_version",
        "unauthenticated",
        "forbidden",
        "not_found",
        "conflict",
        "source_denied",
        "task_cancelled",
        "task_expired",
        "task_failed",
        "needs_attention",
        "model_unavailable",
        "citation_failed",
        "timeout",
        "internal_error",
        "os_access_missing",
        "index_unavailable"
      ]
    },
    "IndexStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "indexed",
        "total",
        "newest_indexed",
        "failed"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "building",
            "rebuilding",
            "needs_attention"
          ]
        },
        "indexed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "newest_indexed": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason_code",
              "count"
            ],
            "properties": {
              "reason_code": {
                "type": "string",
                "enum": [
                  "unsupported_format",
                  "encrypted",
                  "corrupt",
                  "too_large",
                  "limit_exceeded",
                  "extraction_failed",
                  "timeout"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "description": "Counts only. Specification-only in WP3.1: no route serves it."
    },
    "Limitation": {
      "type": "string",
      "enum": [
        "attachments_not_searched",
        "source_type_not_searched",
        "language_unmeasured",
        "language_unsupported",
        "low_confidence",
        "figures_unproven",
        "dates_unproven",
        "context_truncated",
        "partial_work",
        "answer_withheld",
        "task_stopped_no_answer",
        "sensitive_items_excluded",
        "indexing_incomplete",
        "source_unsupported",
        "os_access_missing",
        "attachment_pending"
      ]
    },
    "Locator": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "page",
                "block",
                "message_part",
                "span_only"
              ]
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "block": {
              "type": "integer",
              "minimum": 0
            },
            "message_part": {
              "type": "string",
              "enum": [
                "body",
                "headers",
                "thread"
              ]
            },
            "quoted": {
              "type": "boolean"
            }
          },
          "if": {
            "not": {
              "properties": {
                "kind": {
                  "const": "message_part"
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          "then": {
            "not": {
              "required": [
                "quoted"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "header",
            "authenticity"
          ],
          "properties": {
            "kind": {
              "const": "header_field"
            },
            "header": {
              "type": "string",
              "enum": [
                "from",
                "to",
                "date",
                "subject",
                "message_id"
              ]
            },
            "authenticity": {
              "const": "claimed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "attachment_id"
          ],
          "properties": {
            "kind": {
              "const": "attachment_part"
            },
            "attachment_id": {
              "$ref": "#/$defs/Opaque"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "block": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sheet",
            "cell"
          ],
          "properties": {
            "kind": {
              "const": "sheet_cell"
            },
            "sheet": {
              "type": "integer",
              "minimum": 0,
              "description": "Index of the sheet, never its name (names are content of the owner)."
            },
            "cell": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
            }
          }
        }
      ]
    },
    "ModelDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "role",
        "runtime"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z_]{1,31}$"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "mlx",
            "stub"
          ]
        }
      },
      "description": "Which local model produced the answer. Closed and content-free: never a prompt, source text, path, query or personal data."
    },
    "SafeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "component",
        "correlation_id"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "api.request",
            "client.rejected",
            "task.created",
            "task.transition",
            "task.recovered",
            "policy.decision",
            "retrieval.finished",
            "model.requested",
            "answer.verified",
            "stream.opened",
            "consent.changed",
            "model.routed",
            "egress.decision"
          ]
        },
        "component": {
          "type": "string",
          "enum": [
            "api",
            "identity",
            "service",
            "policy",
            "gate",
            "tasks",
            "answer",
            "stream",
            "consent",
            "model",
            "egress"
          ]
        },
        "correlation_id": {
          "$ref": "#/$defs/Opaque"
        },
        "state_from": {
          "$ref": "#/$defs/TaskState"
        },
        "state_to": {
          "$ref": "#/$defs/TaskState"
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ]
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "granted",
            "nothing_requested",
            "unknown_source_type",
            "restricted_domain",
            "deferred_decision",
            "no_grant",
            "grant_revoked",
            "grant_expired",
            "sensitivity_exceeds_grant",
            "requeued",
            "needs_attention",
            "verified",
            "partially_verified",
            "unverified",
            "failed",
            "allowed",
            "not_a_typed_tool",
            "leak_check",
            "url_not_permitted",
            "private_address",
            "redirect_blocked",
            "length_cap",
            "header_not_allowed",
            "host_not_allowed",
            "provider_disabled",
            "budget_exceeded",
            "primary_model",
            "deep_model",
            "fallback_model",
            "memory_fallback",
            "model_refused"
          ],
          "description": "A closed vocabulary: the policy decisions, recovery actions and verification statuses the Stage 2 Core emits, plus the egress decisions defined by the network policy. A new reason is a contract change, never a free-form string."
        },
        "error_code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "enum": [
            "granted",
            "revoked"
          ]
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z_]{1,31}$"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "destination_class": {
          "type": "string",
          "enum": [
            "search_provider",
            "connector",
            "update_manifest",
            "model_manifest"
          ]
        }
      }
    },
    "PassageText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_index",
        "text",
        "evidence"
      ],
      "properties": {
        "citation_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceRef"
        }
      },
      "description": "The text of one cited span, for the owner to inspect a citation. Served only while every source the answer used is still permitted and the span still resolves exactly; otherwise the call fails closed. Never logged."
    },
    "ComputeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "args"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "arithmetic",
            "convert",
            "days_between",
            "add_days",
            "add_months",
            "weekday"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u001f]{1,200}$"
          }
        }
      },
      "description": "A typed, deterministic computation done by code, never by a model: arithmetic [expression], convert [value, from, to], days_between [start, end], add_days [start, days], add_months [start, months], weekday [date]. Dates are ISO calendar dates. No source is read and nothing is logged."
    },
    "ComputeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "exact",
        "approximate",
        "clamped"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "arithmetic",
            "convert",
            "days_between",
            "add_days",
            "add_months",
            "weekday"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[-0-9a-z./]{1,500}$"
        },
        "exact": {
          "type": "boolean"
        },
        "approximate": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9.]{1,100}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "A labelled rounded form, present only when the exact value has no finite decimal form (for example 1/3)."
        },
        "clamped": {
          "type": "boolean",
          "description": "True when month arithmetic had to move to the last day of the month."
        }
      },
      "description": "The result. `exact` is true when `value` is a finite decimal, an integer, a date or a weekday; false when it is a fraction (numerator/denominator) with no finite decimal form, in which case `approximate` is a labelled rounded decimal. `value` is a decimal, a fraction (numerator/denominator), an ISO date, an integer or a weekday name."
    }
  }
}
