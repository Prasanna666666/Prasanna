;; Seatbelt profile for the cloud gateway: the one program that talks to the cloud provider.
;; It needs the network (to reach the provider) but has no business reading photos, the drive or personal folders, so the kernel refuses that
;; even if the code were changed. It is also never given the library path. Parameter: HOME. Later rules win over earlier ones.
(version 1)
(allow default)

(deny file-read* (subpath "/Volumes"))
(deny file-write* (subpath "/Volumes"))
(deny file-read* (subpath (string-append (param "HOME") "/Pictures")))
(deny file-read* (subpath (string-append (param "HOME") "/Documents")))
(deny file-read* (subpath (string-append (param "HOME") "/Desktop")))
(deny file-read* (subpath (string-append (param "HOME") "/Downloads")))
(deny file-read* (subpath (string-append (param "HOME") "/Movies")))
(deny file-read* (subpath (string-append (param "HOME") "/Library/Mobile Documents")))
(deny file-read* (subpath (string-append (param "HOME") "/Library/Messages")))
(deny file-read* (subpath (string-append (param "HOME") "/ApertureVault.sparsebundle")))
(deny file-read* (subpath (string-append (param "HOME") "/.orbit")))
(deny file-read* (subpath (string-append (param "HOME") "/OrbitInbox")))
