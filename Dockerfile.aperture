# Aperture in a container (Linux). Trade-offs vs the native Mac install: Tesseract reads text in photos instead of Apple Vision
# (a little less accurate) and there is no Metal GPU (CLIP runs on CPU: indexing is much slower). See docs/docker.md.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-nld \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin aperture
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
# CPU-only torch first (works on arm64 and x86), then Aperture with ML + UI extras (not 'mac': pyobjc is macOS-only)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir ".[ml,ui]"
USER 10001
ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1 APERTURE_NEVER_ONLINE=1 APERTURE_SANDBOXED=1 \
    APERTURE_DRIVE=/Volumes/Expansion APERTURE_UI_HOST=0.0.0.0 \
    APERTURE_OLLAMA_URL=http://ollama:11434 APERTURE_TRUSTED_HOSTS=ollama \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENTRYPOINT ["aperture"]
CMD ["web", "--port", "8765"]
